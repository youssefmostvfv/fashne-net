# ==============================================================================
# Fashne.net - Apache Web Server Configuration (.htaccess)
# ==============================================================================

# 1. إعداد الترميز والأمان الأساسي (Encoding & General Settings)
# ------------------------------------------------------------------------------
AddDefaultCharset UTF-8
# اللغة تتحدد من وسم <html lang> في كل صفحة (عربي / إنجليزي)

# منع استعراض محتويات المجلدات (Disable Directory Browsing)
Options -Indexes +FollowSymLinks

# صفحات الخطأ المخصصة (Custom Error Pages)
ErrorDocument 404 /404.html
<If "%{REQUEST_URI} =~ m#^/en(/|$)#">
    ErrorDocument 404 /en/404.html
</If>

# ------------------------------------------------------------------------------
# 2. حماية الملفات الحساسة (Protect Sensitive Files)
# ------------------------------------------------------------------------------
# حظر الملفات المخفية وملفات الإعدادات والاعتماديات
<FilesMatch "(^\..*|package(-lock)?\.json|tailwind\.config\.js|\.(lock|md|log|env|yml|yaml|bak|sql))$">
    Require all denied
</FilesMatch>

# استثناء ملفات التحقق التلقائية مثل Let's Encrypt إن وجدت
<FilesMatch "^well-known">
    Require all granted
</FilesMatch>

# حظر الوصول المباشر إلى مجلدات البرمجة والاعتماديات
RedirectMatch 403 ^/(node_modules|\.git|\.agents)/

# ------------------------------------------------------------------------------
# 3. ترويسات الأمان (Security Headers)
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
    # منع تخمين نوع الملفات (MIME-type sniffing)
    Header always set X-Content-Type-Options "nosniff"

    # حماية ضد Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # حماية ضد هجمات XSS
    Header always set X-XSS-Protection "1; mode=block"

    # حماية سياسة المرجع (Referrer Policy)
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # تعطيل الميزات الحساسة غير المستخدمة في المتصفح
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ------------------------------------------------------------------------------
# 4. إعادة التوجيه والروابط النظيفة (Rewrite Rules & HTTPS)
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # تحويل جميع الطلبات إجبارياً إلى اتصال آمن HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # توحيد الروابط: منع تكرار المحتوى بإزالة index.html من الرابط
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s(.*)/index\.html [NC]
    RewriteRule ^ %1/ [R=301,L]

    # توحيد الروابط: إضافة الشرطة المائلة (Trailing Slash) للمجلدات
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !/$
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [L,R=301]

    # إخفاء امتداد .html للروابط (Clean URLs)
    # 1. إذا طلب الزائر رابطاً ينتهي بـ .html يتم تحويله 301 للرابط بدون الامتداد
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # 2. استدعاء ملف الـ html داخلياً في السيرفر عند طلب الرابط النظيف (يدعم المسارات الفرعية)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f [OR]
    RewriteCond %{REQUEST_FILENAME}\.html -f
    RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# 5. تعريف أنواع الملفات (MIME Types)
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
    # الصور والوسائط الحديثة
    AddType image/webp                     .webp
    AddType image/svg+xml                  .svg .svgz
    AddEncoding gzip                       .svgz

    # الخطوط الحديثة
    AddType font/woff                      .woff
    AddType font/woff2                     .woff2
    AddType application/vnd.ms-fontobject  .eot
    AddType font/ttf                       .ttf
    AddType font/otf                       .otf

    # مستندات و JSON
    AddType application/json               .json
    AddType application/javascript         .js
    AddType text/css                       .css
</IfModule>

# ------------------------------------------------------------------------------
# 6. ضغط الملفات لتسريع الموقع (Gzip / Deflate Compression)
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
</IfModule>

# ------------------------------------------------------------------------------
# 7. التخزين المؤقت في المتصفح (Browser Caching / Leverage Caching)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # كاش الصور وملفات الوسائط (سنة واحدة)
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/jpg                 "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType video/mp4                 "access plus 1 year"
    ExpiresByType video/webm                "access plus 1 year"

    # كاش الخطوط (سنة واحدة)
    ExpiresByType font/ttf                  "access plus 1 year"
    ExpiresByType font/otf                  "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"

    # كاش ملفات CSS و JavaScript (شهر واحد)
    ExpiresByType text/css                  "access plus 1 month"
    ExpiresByType application/javascript    "access plus 1 month"
    ExpiresByType text/javascript           "access plus 1 month"

    # ملفات HTML والبيانات التفاعلية (فترة قصيرة لضمان التحديث)
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType application/json          "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # تطبيق Cache-Control للأصول الثابتة
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|woff|woff2|ttf|svg)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # منع التخزين الطويل لصفحات HTML لضمان وصول التحديثات فوراً
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>
